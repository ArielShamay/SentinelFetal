# SentinelFetal V3 Environment Configuration
# ===========================================
# Copy this file to .env and customize as needed

# Server Configuration
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_DEBUG=false

# CORS Origins (comma-separated)
SENTINEL_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# WebSocket Configuration
SENTINEL_WS_HEARTBEAT_INTERVAL=5.0
SENTINEL_WS_DATA_INTERVAL=0.25

# Simulation
SENTINEL_DEFAULT_PATIENT_COUNT=4
SENTINEL_MAX_PATIENT_COUNT=20

# Logging
SENTINEL_LOG_LEVEL=INFO
